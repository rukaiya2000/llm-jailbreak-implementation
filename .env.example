# UF AI Navigator (default provider — OpenAI-compatible proxy for open-source models)
NAVIGATOR_API_KEY=your_navigator_key_here

# Anthropic (required only if using --*-provider anthropic)
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenAI (required only if using --*-provider openai)
OPENAI_API_KEY=your_openai_key_here

# Fireworks AI (required only if using --*-provider fireworks)
FIREWORKS_API_KEY=your_fireworks_key_here
